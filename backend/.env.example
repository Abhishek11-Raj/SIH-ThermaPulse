# KESHAV environment configuration (example)
# Copy to backend/.env and fill in real values. NEVER commit .env.

APP_ENV=development
APP_NAME=KESHAV
API_VERSION=1.0.0
LOG_LEVEL=INFO

# Local development database (PostgreSQL-compatible via SQLAlchemy in production)
DATABASE_URL=sqlite:///./keshav.db

# Mock mode makes the whole pipeline demoable without any external API.
# Set to false when real providers are wired in later stages.
MOCK_MODE=true
MOCK_SEED=2026
# Demo scenario: NORMAL_DAY | EXTREME_HEAT | HOT_NIGHT | PERSISTENT_HEAT | HEAT_PLUS_POLLUTION | DATA_POOR_AREA
MOCK_SCENARIO=NORMAL_DAY

# External provider keys (placeholders — openmeteo does not require a key)
WEATHER_API_KEY=
AIR_QUALITY_API_KEY=

# Step 2 — provider selection per domain. Options: mock | openmeteo
#   mock      → deterministic synthetic provider (default, always available)
#   openmeteo → live Open-Meteo API (public; no key needed). If unreachable the
#               pipeline degrades to cache then mock, with fallback recorded.
WEATHER_PROVIDER=mock
FORECAST_PROVIDER=mock
AIR_QUALITY_PROVIDER=mock
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Step 2 — provider resilience
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_BASE_BACKOFF_SECONDS=0.5
PROVIDER_CACHE_TTL_SECONDS=1800
FORECAST_CACHE_TTL_SECONDS=7200
# Display timezone for user-facing timestamps (IANA name; tzdata must be installed)
DEFAULT_TIMEZONE=Asia/Kolkata

# CORS: comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8000

# Pipeline / model versioning (used in system info; not secrets)
DATA_PIPELINE_VERSION=0.1.0
MODEL_VERSION=