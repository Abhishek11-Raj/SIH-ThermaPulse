"""KESHAV STEP 6: Intervention and Counterfactual Simulation Schemas.

Pydantic schemas for intervention definitions, scenario construction,
counterfactual predictions, and comparison results.

All schemas enforce strict validation and use qualified language
to avoid unsupported causal claims.
"""

from __future__ import annotations

from datetime import datetime
from typing import Any, Dict, List, Optional

from pydantic import BaseModel, Field, validator, model_validator


# ============================================================
# Intervention Constraint Schema
# ============================================================

class InterventionConstraint(BaseModel):
    """Constraints for an intervention variable."""

    minimum: Optional[float] = None
    maximum: Optional[float] = None
    strict_minimum: bool = False
    strict_maximum: bool = False
    unit: Optional[str] = None
    allowed_direction: Literal["increase", "decrease", "either"] = "either"

    @field_validator("minimum")
    def minimum_less_than_maximum(cls, v, values, **kwargs):
        if "maximum" in values and v is not None and values["maximum"] is not None:
            if v > values["maximum"]:
                raise ValueError("minimum must be <= maximum")
        return v

    @field_validator("maximum")
    def maximum_greater_than_minimum(cls, v, values, **kwargs):
        if "minimum" in values and v is not None and values["minimum"] is not None:
            if v < values["minimum"]:
                raise ValueError("maximum must be >= minimum")
        return v


# ============================================================
# Intervention Definition Schema
# ============================================================

class Intervention(BaseModel):
    """A defined intervention for counterfactual simulation.

    All intervention types must be validated against the KESHAV
    feature pipeline. No causal claims are made about intervention
    outcomes.

    Supported intervention_type string values:
    - outdoor_exposure_reduction
    - work_rest_schedule
    - shade_increase
    - water_access_increase
    - cooling_access_increase
    - power_restoration
    - exposure_time_shift
    - combined
    """

    intervention_id: str
    name: str
    description: str = ""
    intervention_type: str
    target_variable: str
    baseline_value: float
    simulated_value: float
    unit: Optional[str] = None
    constraints: Optional[InterventionConstraint] = None
    affects_thermal_stress: bool = True
    affects_exposure: bool = True
    affects_vulnerability: bool = False
    affects_operational: bool = False
    feasibility_constraints: Optional[Dict[str, Any]] = None
    created_at: datetime = Field(default_factory=datetime.utcnow)

    model_config = "orm_mode": True

    @model_validator(mode="after")
    def simulated_not_identical_to_baseline(self) -> "Intervention":
        # Note: simulated_value comparison with baseline_value is best-effort
        # during schema generation; the actual check is performed at runtime.
        return self

    @model_validator(mode="after")
    def valid_intervention_id(self) -> "Intervention":
        if not self.intervention_id or len(self.intervention_id) < 3:
            raise ValueError("intervention_id must be at least 3 characters")
        return self


# ============================================================
# Supported Intervention Type Constants
# ============================================================

#: Reduce outdoor exposure hours
INTERVENTION_OUTDOOR_EXPOSURE = "outdoor_exposure_reduction"

#: Change work/rest scheduling
INTERVENTION_WORK_REST = "work_rest_schedule"

#: Increase shade availability
INTERVENTION_SHADE_INCREASE = "shade_increase"

#: Increase water access
INTERVENTION_WATER_ACCESS = "water_access_increase"

#: Increase cooling access
INTERVENTION_COOLING_ACCESS = "cooling_access_increase"

#: Power restoration/availability
INTERVENTION_POWER_RESTORATION = "power_restoration"

#: Shift exposure timing to cooler hours
INTERVENTION_EXPOSURE_TIME_SHIFT = "exposure_time_shift"

#: Combined/intervention
INTERVENTION_COMBINED = "combined"


# ============================================================
# InterventionType Enum for type-safe intervention references
# ============================================================

from enum import Enum


class InterventionType(str, Enum):
    """Enum for supported intervention types.

    Provides type-safe references to intervention type strings.
    All values match the intervention_type field in the Intervention schema.
    """

    OUTDOOR_EXPOSURE_REDUCTION = "outdoor_exposure_reduction"
    WORK_REST_SCHEDULE = "work_rest_schedule"
    SHADE_INCREASE = "shade_increase"
    WATER_ACCESS_INCREASE = "water_access_increase"
    COOLING_ACCESS_INCREASE = "cooling_access_increase"
    POWER_RESTORATION = "power_restoration"
    EXPOSURE_TIME_SHIFT = "exposure_time_shift"
    COMBINED = "combined"

    @classmethod
    def is_supported(cls, interv_type: "InterventionType") -> bool:
        """Check if an intervention type is supported."""
        return interv_type in cls.__members__.values()


# ============================================================
# Counterfactual Scenario Schema
# ============================================================

class CounterfactualScenario(BaseModel):
    """A complete counterfactual simulation scenario."""

    scenario_id: str
    location_id: str
    model_version: str
    feature_version: str
    baseline_prediction_id: str
    interventions: List[Intervention]
    scenario_name: str
    description: str = ""
    created_at: datetime = Field(default_factory=datetime.utcnow)
    status: Literal["PENDING", "COMPUTING", "COMPLETED", "FAILED"] = "PENDING"

    baseline_risk_probability: Optional[float] = None
    counterfactual_risk_probability: Optional[float] = None
    risk_delta: Optional[float] = None
    risk_category_baseline: Optional[str] = None
    risk_category_counterfactual: Optional[str] = None
    absolute_risk_delta: Optional[float] = None
    relative_change: Optional[float] = None
    ood_baseline: bool = False
    ood_counterfactual: bool = False
    data_quality_baseline: str = "UNKNOWN"
    data_quality_counterfactual: str = "UNKNOWN"
    explanation_available: bool = False

    feature_manifest_version: str = "1.0"
    threshold_version: str = "1.0"


# ============================================================
# Scenario Request/Response Schemas
# ============================================================

class ScenarioRequest(BaseModel):
    """Request to create a counterfactual scenario."""

    location_id: str
    baseline_prediction_id: str
    scenario_name: str
    description: str = ""
    interventions: List[Intervention]
    model_version: Optional[str] = None
    feature_version: Optional[str] = None
    include_explanation: bool = True
    include_equity: bool = False
    include_uncertainty: bool = True


class ScenarioResponse(BaseModel):
    """Response from a counterfactual scenario simulation."""

    scenario_id: str
    status: Literal["PENDING", "COMPUTING", "COMPLETED", "FAILED"]

    baseline: Dict[str, Any]
    counterfactual: Dict[str, Any]
    comparison: Dict[str, Any]
    changes: List[Dict[str, Any]]
    limitations: List[str] = Field(default_factory=list)

    feature_manifest_version: str
    model_version: str
    scenario_created_at: datetime

    causal_status: Literal["MODEL_BASED_COUNTERFACTUAL"] = "MODEL_BASED_COUNTERFACTUAL"
    disclaimer: str = (
        "This scenario result is a model-based counterfactual simulation. "
        "It does not predict actual health outcomes and should not be "
        "interpreted as medical advice or guaranteed risk reduction."
    )


# ============================================================
# Intervention Registry
# ============================================================

class InterventionRegistry:
    """Registry for tracking supported intervention types."""

    _supported: frozenset = frozenset(
        {
            "outdoor_exposure_reduction",
            "work_rest_schedule",
            "shade_increase",
            "water_access_increase",
            "cooling_access_increase",
            "power_restoration",
            "exposure_time_shift",
            "combined",
        }
    )

    @classmethod
    def is_supported(cls, interv_type: str) -> bool:
        """Check if an intervention type is supported."""
        return interv_type in cls._supported


# ============================================================
# Equity and Data Coverage Schemas
# ============================================================

class ScenarioEquityResult(BaseModel):
    """Equity analysis results for a scenario."""

    scenario_id: str
    subgroup_sample_counts: Dict[str, int]
    baseline_risks: Dict[str, float]
    counterfactual_risks: Dict[str, float]
    risk_deltas: Dict[str, float]
    sufficient_sample: Dict[str, bool]
    data_coverage: Dict[str, float]
    insufficient_sample_subgroups: List[str] = Field(default_factory=list)
    limitations: List[str] = Field(default_factory=list)


class DataCoverageInfo(BaseModel):
    """Data coverage information for a scenario."""

    scenario_id: str
    overall_coverage: float
    coverage_class: Literal["DATA_RICH", "ADEQUATE", "DATA_POOR"]
    per_feature: Dict[str, float]
    quality_class: Literal["BEST", "GOOD", "FAIR", "POOR"]
    ood_status: bool = False
    message: Optional[str] = None